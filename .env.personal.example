# Check Gemini billing in Google AI Studio first. Do not assume ChatGPT usage covers it.
PERSONAL_GEMINI_FREE_TIER_CONFIRMED=NO
# Use a BRAND NEW dedicated personal-use sheet (NOT GOOGLE_SHEET_ID).
PERSONAL_GOOGLE_SHEET_ID=
