# RELEASE CANDIDATE: do not copy these limits to the scheduled run before cutover.
# Existing local .env overrides these defaults after a future merge.
# Copy relevant lines into your local .env. DO NOT commit .env or personal profile.
PERSONAL_PROFILE_PATH=profiles/personal_profile.local.txt
PERSONAL_MAX_ARBEITNOW_CALLS=4
PERSONAL_MAX_REMOTIVE_CALLS=1
# Adzuna international — OFF by default. May be enabled only with the
# registered ADZUNA_APP_ID/ADZUNA_APP_KEY and an explicit positive call budget
# up to 12. Four EU markets x two searches = 8 first-page requests if enabled.
PERSONAL_MAX_ADZUNA_CALLS=0
PERSONAL_ADZUNA_MARKETS=de,nl,fr,es
PERSONAL_ADZUNA_TERMS=ecommerce,operations
PERSONAL_ADZUNA_PAGES_PER_QUERY=1
# Store these in your local gitignored .env, never in GitHub:
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
PERSONAL_MAX_HIMALAYAS_CALLS=17
PERSONAL_MAX_JOBICY_CALLS=3
# Experimentally verified optional sources. Keep in daily merge proposal:
# one Remote OK, one WWR and one RemoteJobs.org page, as requested.
# The source-code fallback remains zero if this local opt-in is absent;
# do not deploy to production until the source merge has been approved.
PERSONAL_MAX_REMOTE_OK_CALLS=1
PERSONAL_MAX_WWR_CALLS=1
PERSONAL_MAX_REMOTEJOBS_ORG_CALLS=1
PERSONAL_MAX_GEMINI_CALLS=5
# Pre-AI selection cap (default 40 across sources; does not trigger AI on collect-only).
PERSONAL_MAX_AI_CANDIDATES=40
PERSONAL_GEMINI_MODEL=gemini-3.5-flash-lite
# Check Gemini billing in Google AI Studio first. Do not assume ChatGPT usage covers it.
PERSONAL_GEMINI_FREE_TIER_CONFIRMED=NO
# At approved cutover use the existing Expanded RAY workbook, NEVER the original Personal RAY ID.
PERSONAL_GOOGLE_SHEET_ID=
