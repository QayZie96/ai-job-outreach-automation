# Copy relevant lines into your local .env. DO NOT commit .env or personal profile.
PERSONAL_PROFILE_PATH=profiles/personal_profile.local.txt
PERSONAL_MAX_ARBEITNOW_CALLS=2
PERSONAL_MAX_REMOTIVE_CALLS=1
PERSONAL_MAX_ADZUNA_CALLS=0
PERSONAL_MAX_HIMALAYAS_CALLS=4
PERSONAL_MAX_JOBICY_CALLS=2
PERSONAL_MAX_GEMINI_CALLS=5
